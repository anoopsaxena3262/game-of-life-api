{
  "Urls": "http://*:8080",
  "ConnectionStrings": {
    "Default": "Data Source=data/game-of-life.db;Default Timeout=5"
  },
  "GameOfLife": {
    "MaxGenerations": 1000,
    "MaxGenerationsCeiling": 10000,
