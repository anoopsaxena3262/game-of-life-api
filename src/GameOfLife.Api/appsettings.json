{
  "ConnectionStrings": {
    "Default": "Data Source=data/game-of-life.db"
  },
  "Persistence": {
    "Provider": "Sqlite"
  },
  "GameOfLife": {
    "MaxBoardCells": 1000000,
    "MaxGenerationsPerRequest": 100000,
    "MaxSyncGenerationLimit": 50000,
    "DefaultGenerationLimit": 1000,
    "SnapshotInterval": 100,
    "TreatPeriodicAsTerminal": false
  },
  "OpenTelemetry": {
    "ConsoleExporter": false,
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
